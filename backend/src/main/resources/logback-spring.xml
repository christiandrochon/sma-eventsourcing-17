<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Lire le répertoire de logs depuis application.properties (logging.file.path) -->
    <springProperty name="LOG_DIR" source="logging.file.path" defaultValue="backend/logs"/>

    <!-- Console : erreurs techniques uniquement -->
    <appender name="CONSOLE_WARN" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Console : logs métier -->
    <appender name="CONSOLE_BIZ" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} BIZ   - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Fichier : logs métier → backend/logs/business.log -->
    <appender name="BUSINESS_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/business.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/business.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Fichier : erreurs techniques → backend/logs/technical.log -->
    <appender name="TECHNICAL_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/technical.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/technical.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{50} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Logger métier (BusinessLoggers) -->
    <logger name="BUSINESS" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE_BIZ"/>
        <appender-ref ref="BUSINESS_FILE"/>
    </logger>

    <!-- Root : erreurs techniques vers console + fichier -->
    <root level="WARN">
        <appender-ref ref="CONSOLE_WARN"/>
        <appender-ref ref="TECHNICAL_FILE"/>
    </root>
</configuration>

